# --- Supabase (optional for local demo; required for live data + admin CRUD) ---
# Project URL, e.g. https://xyzcompany.supabase.co  (safe to expose, used client-side at build)
PUBLIC_SUPABASE_URL=
# anon public key (read-only catalog access)
SUPABASE_ANON_KEY=
# service role key (admin CRUD only — NEVER expose publicly)
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth ---
ADMIN_PASSWORD=
# Random long string used to HMAC-sign the session cookie, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# --- Cloudflare Pages deploy hook (POST'ed after each admin mutation to rebuild the site) ---
DEPLOY_HOOK_URL=

# --- Canonical site URL used for sitemap/OG/canonical tags ---
SITE_URL=https://example.com
