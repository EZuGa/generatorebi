---
export const prerender = false;

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostForm from '../../../../components/admin/PostForm.astro';
import { getPosts, getAllPosts, type Post } from '../../../../lib/posts';
import { getEnv } from '../../../../lib/env';
import { IMAGE_ERROR_MESSAGES } from '../../../../lib/supabase-admin';

const url = getEnv(Astro.locals, 'PUBLIC_SUPABASE_URL');
const serviceKey = getEnv(Astro.locals, 'SUPABASE_SERVICE_ROLE_KEY');
const dbConnected = Boolean(url && serviceKey);

const { id } = Astro.params;

// Drafts must be editable too — use the service role list when available.
let posts: Post[];
if (dbConnected) {
  try {
    posts = await getAllPosts(url as string, serviceKey as string);
  } catch {
    posts = await getPosts();
  }
} else {
  posts = await getPosts();
}
const post = posts.find((p) => p.id === id);

if (!post) {
  return Astro.redirect('/admin/posts');
}

const error = Astro.url.searchParams.get('error');
const errorMessage = error ? IMAGE_ERROR_MESSAGES[error] : undefined;
---

<BaseLayout title={`ადმინი — ${post.title}`} description="სტატიის რედაქტირება." index={false}>
  <div class="admin-wrap">
    <div class="admin-topbar">
      <div>
        <span class="kicker">ადმინი</span>
        <h1 style="margin:0;">რედაქტირება: {post.title}</h1>
      </div>
      <a class="link-muted" href="/admin/posts">← სიაში დაბრუნება</a>
    </div>

    {
      dbConnected ? (
        <div class="panel">
          {errorMessage && <div class="notice notice-error">{errorMessage}</div>}
          <PostForm action={`/api/posts/${post.id}`} post={post} />
        </div>
      ) : (
        <div class="notice notice-warn">
          მონაცემთა ბაზა არ არის დაკავშირებული — რედაქტირება მიუწვდომელია.
        </div>
      )
    }
  </div>
</BaseLayout>
