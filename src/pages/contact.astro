---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="კონტაქტი"
  description="დაგვიკავშირდით: +995 555 00 00 00, info@generatori.ge — თბილისი, საქართველო. სამუშაო საათები: ორშ–შაბ 09:00–18:00."
>
  <section class="page-hero">
    <div class="container">
      <span class="kicker">კონტაქტი</span>
      <h1>დაგვიკავშირდით</h1>
      <p>კონსულტაცია, ფასის მითითება ან სერვისის მოთხოვნა — ჩვენ მუდმივად ხაზზე ვართ.</p>
    </div>
  </section>

  <nav class="breadcrumbs container" aria-label="ბრედკრამბი">
    <ol>
      <li><a href="/">მთავარი</a></li>
      <li><span aria-current="page">კონტაქტი</span></li>
    </ol>
  </nav>

  <section class="section" style="padding-top: 32px;">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-card">
          <h2>ტელეფონი</h2>
          <a href="tel:+995555000000">+995 555 00 00 00</a>
          <p>ზარები მიიღება სამუშაო საათებში; საგანგებო ხაზი — 24/7.</p>
        </div>
        <div class="contact-card">
          <h2>ელფოსტა</h2>
          <a href="mailto:info@generatori.ge">info@generatori.ge</a>
          <p>მოგვწერეთ ტექნიკური მოთხოვნები — ვპასუხობთ ერთი სამუშაო დღის განმავლობაში.</p>
        </div>
        <div class="contact-card">
          <h2>მისამართი</h2>
          <a>თბილისი, საქართველო</a>
          <p>საწყობი და შოურუმი — ზუსტი მისამართისთვის დაგვირეკეთ.</p>
        </div>
        <div class="contact-card">
          <h2>სამუშაო საათები</h2>
          <a>ორშ–შაბ: 09:00–18:00</a>
          <p>კვირა — დასვენება. საგანგებო სერვისი მუშაობს მუდმივად.</p>
        </div>
      </div>

      <div class="cta-band" style="margin-top: 44px;">
        <div>
          <h2>ფასის მისაღებად ყველაზე სწრაფი გზა — ზარი</h2>
          <p>მოგვყევით რა სიმძლავრის აგრეგატი გჭირდებათ და სად — პასუხი 5 წუთში.</p>
        </div>
        <a href="tel:+995555000000" class="btn btn-dark">+995 555 00 00 00</a>
      </div>
    </div>
  </section>
</BaseLayout>
