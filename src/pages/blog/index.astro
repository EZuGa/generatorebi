---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout
  title="სტატიები — გენერატორების შერჩევა, მოვლა, რჩევები"
  description="სასარგებლო სტატიები დიზელ-გენერატორებისა და სამრეწველო აღჭურვილობის შესახებ: შერჩევა, ექსპლუატაცია, მოვლა და სერვისი."
>
  <section class="page-hero">
    <div class="container">
      <span class="kicker">ბლოგი</span>
      <h1>სტატიები</h1>
      <p>რჩევები და გამოცდილება გენერატორების შერჩევასა და ექსპლუატაციაში.</p>
    </div>
  </section>

  <nav class="breadcrumbs container" aria-label="ბრედკრამბი">
    <ol>
      <li><a href="/">მთავარი</a></li>
      <li><span aria-current="page">სტატიები</span></li>
    </ol>
  </nav>

  <section class="section" style="padding-top: 32px;">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="product-grid">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="product-card">
                {post.image && (
                  <div class="product-card-img">
                    <img
                      src={post.image}
                      alt={post.title}
                      width="800"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="product-card-body">
                  <span class="post-date">{formatDate(post.created_at)}</span>
                  <h3>{post.title}</h3>
                  <p class="post-excerpt">{post.excerpt}</p>
                  <span class="card-link" style="margin-top: auto;">წაიკითხეთ →</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p>სტატიები მალე დაემატება.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
