---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES } from '../lib/categories';
import { getFeaturedProducts } from '../lib/products';

const featured = await getFeaturedProducts(6);

const site = Astro.site ?? new URL('https://example.com');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'GENERATORI.GE',
  description:
    'დიზელ-გენერატორების, სამრეწველო ჩილერებისა და სათადარიგო ნაწილების მიწოდება საქართველოში.',
  url: site.href,
  telephone: '+995555000000',
  email: 'info@generatori.ge',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'თბილისი',
    addressCountry: 'GE',
  },
  openingHours: 'Mo-Sa 09:00-18:00',
  areaServed: { '@type': 'Country', name: 'Georgia' },
};

const trustItems = [
  {
    title: 'ოფიციალური გარანტია',
    text: 'ყველა აგრეგატზე ვრცელდება გარანტია და გრძელვადიანი სერვის-ხელშეკრულება.',
    icon: 'M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z',
  },
  {
    title: 'მიწოდება მთელ საქართველოში',
    text: 'მიწოდება, მონტაჟი და გაშვება ნებისმიერ რეგიონში — თბილისი, ბათუმი, ქუთაისი.',
    icon: 'M3 7h11v8H3z M14 10h4l3 3v2h-7z M5.5 18a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M17.5 18a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  },
  {
    title: '24/7 ტექნიკური მხარდაჭერა',
    text: 'საგანგებო სიტუაციაში ჩვენი ინჟინრები საჭიროების შემთხვევაში ადგილზე გამოგივლიან.',
    icon: 'M14.7 6.3a4.5 4.5 0 0 0-6 6L3 18l3 3 5.7-5.7a4.5 4.5 0 0 0 6-6L14 13l-3-3 3.7-3.7z',
  },
];
---

<BaseLayout
  title="დიზელ-გენერატორები, ჩილერები და სათადარიგო ნაწილები საქართველოში"
  description="დიზელ-გენერატორები 20–500 kVA, სამრეწველო ჩილერები და ორიგინალი სათადარიგო ნაწილები. მიწოდება მთელ საქართველოში, გარანტია და 24/7 სერვისი."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <span class="kicker">სამრეწველო აღჭურვილობა</span>
      <h1>დიზელ-გენერატორები და <em>სამრეწველო აღჭურვილობა</em></h1>
      <p class="hero-sub">
        ენერგოუსაფრთხოება თქვენი ბიზნესისთვის: გენერატორები 20-დან 500 kVA-მდე,
        ჰაეროვანი ჩილერები და ორიგინალი სათადარიგო ნაწილები — მარაგიდან, თბილისიდან.
      </p>
      <div class="hero-ctas">
        <a href="/catalog" class="btn btn-primary">კატალოგის ნახვა</a>
        <a href="/contact" class="btn btn-outline">დაგვიკავშირდით</a>
      </div>
      <div class="hero-stats">
        <span class="stat-chip">150+ ერთეული მარაგში</span>
        <span class="stat-chip">24/7 მხარდაჭერა</span>
        <span class="stat-chip">მიწოდება მთელ საქართველოში</span>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">კატეგორიები</span>
        <h2>პროდუქციის მიმართულებები</h2>
        <p>სამი ძირითადი მიმართულება — ენერგია, გაგრილება და მომსახურება.</p>
      </div>
      <div class="cat-grid">
        {
          CATEGORIES.map((cat) => (
            <a href={`/catalog/${cat.slug}`} class="cat-tile">
              <img src={cat.image} alt={cat.name} width="800" height="600" loading="lazy" decoding="async" />
              <div class="cat-tile-body">
                <h3>{cat.name}</h3>
                <p>{cat.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-head">
        <span class="kicker">რჩეული</span>
        <h2>გამორჩეული პროდუქტები</h2>
        <p>ყველაზე მოთხოვნადი მოდელები მარაგიდან.</p>
      </div>
      <div class="product-grid">
        {featured.map((product, i) => <ProductCard product={product} lazy={i > 2} />)}
      </div>
      <p style="margin-top: 28px;">
        <a href="/catalog" class="btn btn-dark">სრული კატალოგი →</a>
      </p>
    </div>
  </section>

  <!-- Trust / USP band -->
  <section class="section trust-band">
    <div class="container">
      <div class="section-head">
        <span class="kicker">რატომ ჩვენ</span>
        <h2 style="color:#fff;">საიმედო პარტნიორი ენერგიისთვის</h2>
      </div>
      <div class="trust-grid">
        {
          trustItems.map((item) => (
            <div class="trust-item">
              <span class="trust-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={item.icon} />
                </svg>
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>გჭირდებათ კონსულტაცია ან ფასის მითითება?</h2>
          <p>დაგვირეკეთ — ჩვენი ინჟინერი დაგეხმარებათ სწორი აგრეგატის შერჩევაში.</p>
        </div>
        <a href="tel:+995555000000" class="btn btn-dark">+995 555 00 00 00</a>
      </div>
    </div>
  </section>
</BaseLayout>
