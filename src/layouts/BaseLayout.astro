---
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/700.css';
import '@fontsource/noto-sans-georgian/900.css';
// Cyrillic fallback for the /ru/ pages — font files only download when Cyrillic
// glyphs are actually rendered, so ka pages pay no runtime cost.
import '@fontsource/noto-sans/400.css';
import '@fontsource/noto-sans/700.css';
import '@fontsource/noto-sans/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { stripRuPrefix, localePath, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Set false for admin pages that should not be indexed */
  index?: boolean;
  lang?: Lang;
  /** Render without the site header/footer (admin pages) */
  bare?: boolean;
}

const { title, description, ogImage = '/favicon.svg', ogType = 'website', index = true, lang = 'ka', bare = false } = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const fullTitle = title.includes('GENERATORI.GE') ? title : `${title} | GENERATORI.GE`;

// hreflang pair: slugs are shared, so the ka path is just the pathname minus /ru.
const kaPath = stripRuPrefix(Astro.url.pathname);
const kaUrl = new URL(kaPath, site).href;
const ruUrl = new URL(localePath(kaPath, 'ru'), site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ka" href={kaUrl} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={kaUrl} />
    {!index && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'ka_GE'} />
    <meta property="og:site_name" content="GENERATORI.GE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
  </head>
  <body>
    {bare ? <slot /> : (
      <>
        <Header lang={lang} />
        <main>
          <slot />
        </main>
        <Footer lang={lang} />
      </>
    )}
  </body>
</html>
