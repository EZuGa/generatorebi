---
import { localePath, switchLocalePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'ka' } = Astro.props;

const navItems = [
  { href: localePath('/', lang), label: t(lang, 'nav.home') },
  { href: localePath('/catalog', lang), label: t(lang, 'nav.catalog') },
  { href: localePath('/blog', lang), label: t(lang, 'nav.blog') },
  { href: localePath('/contact', lang), label: t(lang, 'nav.contact') },
];

const pathname = Astro.url.pathname;
const kaHref = switchLocalePath(pathname, 'ka');
const ruHref = switchLocalePath(pathname, 'ru');
---

<header class="site-header">
  <div class="container header-inner">
    <a href={localePath('/', lang)} class="logo" aria-label={t(lang, 'aria.logo')}>
      <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="12" fill="#f59e0b"></rect>
        <path d="M36 8 L18 36 h12 L28 56 L46 26 h-12 z" fill="#15181d"></path>
      </svg>
      GENERATORI<span>.GE</span>
    </a>

    <button class="nav-toggle" aria-label={t(lang, 'aria.menu')} aria-expanded="false" aria-controls="main-nav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav class="main-nav" id="main-nav" aria-label={t(lang, 'aria.mainNav')}>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-phone" href="tel:+995595594100">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      +995 595 59 41 00
    </a>

    <nav class="lang-switch" aria-label={t(lang, 'aria.langSwitch')}>
      <a href={kaHref} hreflang="ka" aria-current={lang === 'ka' ? 'true' : undefined} class:list={[{ active: lang === 'ka' }]}>KA</a>
      <span aria-hidden="true">|</span>
      <a href={ruHref} hreflang="ru" aria-current={lang === 'ru' ? 'true' : undefined} class:list={[{ active: lang === 'ru' }]}>RU</a>
    </nav>
  </div>
</header>

<script>
  // Mobile nav toggle — the only client-side JS on the site.
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });
</script>
