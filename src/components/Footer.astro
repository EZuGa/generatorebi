---
import { CATEGORIES, categoryName } from '../lib/categories';
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'ka' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <h3>GENERATORI.GE</h3>
        <p>{t(lang, 'footer.about')}</p>
      </div>

      <nav aria-label={t(lang, 'aria.footerNav')}>
        <h3>{t(lang, 'footer.nav')}</h3>
        <ul>
          <li><a href={localePath('/', lang)}>{t(lang, 'nav.home')}</a></li>
          <li><a href={localePath('/catalog', lang)}>{t(lang, 'nav.catalog')}</a></li>
          {CATEGORIES.map((c) => <li><a href={localePath(`/catalog/${c.slug}`, lang)}>{categoryName(c.key, lang)}</a></li>)}
          <li><a href={localePath('/blog', lang)}>{t(lang, 'nav.blog')}</a></li>
          <li><a href={localePath('/contact', lang)}>{t(lang, 'nav.contact')}</a></li>
        </ul>
      </nav>

      <div>
        <h3>{t(lang, 'footer.contact')}</h3>
        <ul>
          <li><a href="tel:+995595594100">+995 595 59 41 00</a></li>
          <li><a href="mailto:madcom777@mail.ru">madcom777@mail.ru</a></li>
          <li>{t(lang, 'contact.address')}</li>
          <li>{t(lang, 'contact.hours')}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} GENERATORI.GE — {t(lang, 'footer.rights')}</span>
      <span>{t(lang, 'footer.tagline')}</span>
    </div>
  </div>
</footer>
