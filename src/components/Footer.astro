---
import { CATEGORIES, categoryName } from '../lib/categories';
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'ka' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <h3>GENERATORI.COM.GE</h3>
        <p>{t(lang, 'footer.about')}</p>
      </div>

      <nav aria-label={t(lang, 'aria.footerNav')}>
        <h3>{t(lang, 'footer.nav')}</h3>
        <ul>
          <li><a href={localePath('/', lang)}>{t(lang, 'nav.home')}</a></li>
          <li><a href={localePath('/catalog', lang)}>{t(lang, 'nav.catalog')}</a></li>
          {CATEGORIES.map((c) => <li><a href={localePath(`/catalog/${c.slug}`, lang)}>{categoryName(c.key, lang)}</a></li>)}
          <li><a href={localePath('/blog', lang)}>{t(lang, 'nav.blog')}</a></li>
          <li><a href={localePath('/contact', lang)}>{t(lang, 'nav.contact')}</a></li>
        </ul>
      </nav>

      <div>
        <h3>{t(lang, 'footer.contact')}</h3>
        <ul>
          <li><a href="tel:+995595594100">+995 595 59 41 00</a></li>
          <li><a href="mailto:madcom777@mail.ru">madcom777@mail.ru</a></li>
          <li>{t(lang, 'contact.address')}</li>
          <li>{t(lang, 'contact.hours')}</li>
        </ul>
      </div>
    </div>

    <div class="footer-partners">
      <script is:inline async src="//counter.top.ge/counter.js"></script>
      <div id="top-ge-counter-container" data-site-id="116343"></div>
      <!-- SAITEBI.NET BANNER CODE -->
      <a
        href="http://SAITEBI.NET/"
        target="_blank"
        rel="noopener"
        title="საიტი რომელზეც შეგიძლიათ მოიძიოთ თქვენთვის სასურველი საიტი"
      >
        <img src="/images/saitebiNet.webp" height="31" width="88" alt="Saitebi.Net" />
      </a>
      <!-- / END SAITEBI.NET BANNER CODE -->
      <a
        href="https://yellow.place/en/%E1%83%92%E1%83%94%E1%83%9C%E1%83%94%E1%83%A0%E1%83%90%E1%83%A2%E1%83%9D%E1%83%A0%E1%83%94%E1%83%91%E1%83%98%E1%83%A1-%E1%83%9B%E1%83%90%E1%83%A6%E1%83%90%E1%83%96%E1%83%98%E1%83%90-tbilisi-georgia"
        target="_blank"
        rel="noopener"
      >
        Yellow.Place
      </a>
      <a
        href="http://saitebi.sul.ge"
        target="_blank"
        rel="noopener"
        title="მოიძიე შენთვის სასურველი საიტი"
      >
        <img
          src="http://saitebi.sul.ge/images/banner.png"
          width="88"
          height="31"
          alt="saitebi.sul.ge"
        />
      </a>
    </div>

    <div class="footer-bottom">
      <span>© {year} GENERATORI.COM.GE — {t(lang, 'footer.rights')}</span>
      <span>{t(lang, 'footer.tagline')}</span>
    </div>
  </div>
</footer>
