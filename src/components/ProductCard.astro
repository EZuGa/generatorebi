---
import type { Product } from '../lib/products';
import { categoryName } from '../lib/categories';
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  product: Product;
  /** First-row images should load eagerly; pass true to lazy-load. */
  lazy?: boolean;
  lang?: Lang;
}

const { product, lazy = true, lang = 'ka' } = Astro.props;
const chips = product.specs.slice(0, 2);
// Haystack for the client-side catalog search: name, category, every spec and the description.
const searchText = [
  product.name,
  categoryName(product.category, lang),
  product.short_desc,
  ...product.specs.flatMap((s) => [s.label, s.value]),
]
  .join(' ')
  .toLowerCase();
---

<a href={localePath(`/products/${product.slug}`, lang)} class="product-card" data-search={searchText}>
  <div class="product-card-img">
    <img
      src={product.image}
      alt={product.name}
      width="800"
      height="600"
      loading={lazy ? 'lazy' : 'eager'}
      decoding="async"
    />
    <span class="badge">{categoryName(product.category, lang)}</span>
  </div>
  <div class="product-card-body">
    <h3>{product.name}</h3>
    {
      chips.length > 0 && (
        <div class="spec-chips">
          {chips.map((s) => (
            <span class="spec-chip">{s.value}</span>
          ))}
        </div>
      )
    }
    <span class="price-line">{t(lang, 'product.priceOnRequest')}</span>
    <span class="card-link">{t(lang, 'product.details')}</span>
  </div>
</a>
